# Configuración del backend (apps/api). Copia este fichero a .env y ajusta.
# NUNCA commitees credenciales reales (NFR-03): .env está en .gitignore.

# --- SMTP ---
# Modo nativo (pnpm dev): Mailpit corre en Docker y expone el puerto en localhost.
#   SMTP_HOST=localhost
# Modo full (docker compose up): el servicio api resuelve Mailpit por el nombre del
#   servicio; el compose sobreescribe SMTP_HOST=mailpit automáticamente (no lo edites aquí).
SMTP_HOST=localhost
SMTP_PORT=1025
# true solo para SMTP sobre TLS (p. ej. 465). Con Mailpit en dev: false.
SMTP_SECURE=false
# Vacíos en Mailpit; rellénalos con las credenciales del proveedor real.
SMTP_USER=
SMTP_PASSWORD=
# Remitente por defecto de los correos.
MAIL_FROM=aidd-training <no-reply@example.com>

# --- Adjunto ---
# Límite del adjunto en MB (binarios, 10 MiB). Por defecto 10.
MAX_ATTACHMENT_SIZE_MB=10

# --- Servidor ---
# Puerto del backend Express.
PORT=3000
# Origen permitido para CORS. Modo nativo: el dev server de Vite.
#   Modo full Docker: el origen del servicio web (ajústalo según el compose).
WEB_ORIGIN=http://localhost:5173
